# RaagaReel AI API & Infrastructure Configuration
# Copy this file to '.env' and fill in your keys. DO NOT COMMIT REAL KEYS TO GIT.

# 1. Gemini API Key (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# 2. ElevenLabs API Key (ElevenLabs TTS: https://elevenlabs.io/)
ELEVENLABS_API_KEY=

# 3. Cloudflare R2 / S3 Object Storage (Optional, falls back to local /outputs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# 4. Production Domain & Free-Tier Quota Safety Limits
RENDER_EXTERNAL_URL=
MAX_UPLOAD_SIZE_MB=100
MAX_CLIPS_COUNT=10
MAX_VIDEO_DURATION_SEC=60
MAX_CONCURRENT_JOBS=3
